{
  "name": "violet-hour",
  "version": "2.3.1",
  "private": true,
  "description": "Violet Hour - a violet color theme for Visual Studio 2022 and VS Code, dark and light. Original palette, contrast-verified.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-theme.js && node scripts/contrast-check.js",
    "theme": "node scripts/build-theme.js",
    "check": "node scripts/contrast-check.js",
    "vsix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-vsix.ps1",
    "vscode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-vscode.ps1",
    "vscode:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-vscode.ps1 -Uninstall",
    "preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview.ps1",
    "preview:markup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview.ps1 -Sample markup",
    "preview:light": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview.ps1 -Variant light"
  }
}
