<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
                 xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- Publisher is the display name shown in Extensions > Manage Extensions.
         Change it if you want your own name on it. -->
    <Identity Id="VioletHour.4ACF8CE7-F434-4C4E-ABE5-CECBB2C41A53"
              Version="2.2.0"
              Language="en-US"
              Publisher="Jeffrey Hamilton" />
    <DisplayName>Violet Hour</DisplayName>
    <Description xml:space="preserve">A deep violet color theme for Visual Studio 2022, tuned for JavaScript, TypeScript, JSX/TSX and CSS. Named for the half-hour after sunset: a violet field, cool sky colors for structure, and the last warm light of the day for strings and numbers. Italic comments, keywords and parameters. Every color solved against a contrast budget rather than picked by eye.</Description>
    <MoreInfo>https://github.com/JeffreyHamilton6399/violet-hour</MoreInfo>
    <License>LICENSE.txt</License>
    <Icon>icon.png</Icon>
    <Tags>theme, color theme, dark, violet, purple, javascript, typescript, react</Tags>
  </Metadata>
  <Installation>
    <!-- All three editions are listed explicitly. Targeting only Community
         relies on VS treating higher SKUs as a superset; naming them removes
         any chance of the installer refusing on Pro or Enterprise. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  Version="[17.0,18.0)"
                  DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <!-- The pkgdef produced by ThemeConverter. Build Action = Content,
         Include in VSIX = true (see VioletHour.csproj). -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="VioletHour.pkgdef" />
  </Assets>
</PackageManifest>
